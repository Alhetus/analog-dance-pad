# Lets the logged-in user (uaccess) and the plugdev group open ADP pads over
# hidraw without root. Covers both USB IDs adp-tool recognizes (HID_IDS).
# No ACTION match, so `udevadm trigger` (a "change" event) applies it to
# pads that are already plugged in too.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="b196", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="03eb", ATTRS{idProduct}=="204f", MODE="0660", GROUP="plugdev", TAG+="uaccess"
